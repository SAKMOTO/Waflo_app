# ============================================
# WAFLO APP - ENVIRONMENT VARIABLES
# ============================================
# 
# Instructions:
# 1. Copy this file to .env
# 2. Replace all [...] values with your actual credentials
# 3. NEVER commit .env to version control
# 4. NEVER share these values publicly
#

# ============================================
# HUGGING FACE API (Optional if using Ollama)
# ============================================
# Get from: https://huggingface.co/settings/tokens
# Used for: Image generation, Text generation (fallback)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# TAVILY WEB SEARCH API
# ============================================
# Get from: https://tavily.com
# Used for: Web search functionality
TAVILY_API_KEY=tvly_xxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# 
# Step 1: Create Supabase project at https://supabase.com
# Step 2: Go to Project Settings → API
# Step 3: Copy credentials below
#

# Your Supabase project URL
# Format: https://[project-id].supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Key (safe to expose in frontend)
# Used for client-side auth
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (KEEP SECRET - backend only)
# Used for server-side operations
# ⚠️ NEVER share this key or commit to version control
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================
# OPTIONAL: OLLAMA CONFIGURATION
# ============================================
# If using local Ollama instead of Hugging Face
# Download from: https://ollama.ai
#
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=mistral

# ============================================
# BROWSER USE API (For AI Agentic Commerce)
# ============================================
# Get free API key from: https://cloud.browser-use.com/new-api-key
# Used for: Real-time browser automation for commerce tasks
BROWSER_USE_API_KEY=bu_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# RAZORPAY (Test Mode - AI Commerce Checkout)
# ============================================
# Get test keys from: https://dashboard.razorpay.com/app/keys (toggle to Test Mode)
# Used for: Creating orders and initiating test payments for the AI commerce agent.
# The agent uses a bounded, user-gated checkout - it never pays autonomously.
# If left empty, the backend runs in "demo payment" mode so the flow still works.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx
